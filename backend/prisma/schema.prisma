generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Asset {
  id            String   @id @default(uuid())
  name          String
  serialNumber  String   @unique
  category      String
  department    String
  status        String   @default("Available") // Available, Allocated, Reserved, Maintenance, Disposed, Lost
  purchaseDate  DateTime
  purchaseValue Float
  location      String
  qrCode        String?

  allocations   Allocation[]
  transfers     TransferRequest[]
  maintenance   MaintenanceRequest[]
  bookings      Booking[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Allocation {
  id               String   @id @default(uuid())
  assetId          String
  asset            Asset    @relation(fields: [assetId], references: [id])
  assetName        String
  serialNumber     String
  allocatedTo      String
  allocatedToEmail String
  department       String
  allocatedDate    DateTime
  status           String   @default("Active") // Active, Returned

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TransferRequest {
  id             String   @id @default(uuid())
  assetId        String
  asset          Asset    @relation(fields: [assetId], references: [id])
  assetName      String
  serialNumber   String
  fromEmployee   String
  toEmployee     String
  fromDepartment String
  toDepartment   String
  requestedDate  DateTime
  status         String   @default("Pending") // Pending, Approved, Rejected

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MaintenanceRequest {
  id             String   @id @default(uuid())
  assetId        String
  asset          Asset    @relation(fields: [assetId], references: [id])
  assetName      String
  description    String
  priority       String // Low, Medium, High
  status         String   @default("Pending") // Pending, In Progress, Completed
  requestedDate  DateTime
  facilityHealth String

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AuditCycle {
  id             String   @id @default(uuid())
  name           String
  startDate      DateTime
  endDate        DateTime
  auditor        String
  status         String   @default("Pending") // Pending, In Progress, Completed
  progress       Float    @default(0)
  missingAssets  Int      @default(0)
  discrepancies  Int      @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String // info, success, warning, error
  isRead    Boolean  @default(false)
  
  createdAt DateTime @default(now())
}

model Booking {
  id        String   @id @default(uuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id])
  assetName String
  bookedBy  String
  startDate DateTime
  endDate   DateTime
  status    String   @default("Confirmed") // Confirmed, Cancelled

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
